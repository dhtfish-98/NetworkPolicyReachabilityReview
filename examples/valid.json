{
  "namespaces": [
    {
      "name": "a",
      "labels": {
        "team": "client"
      }
    },
    {
      "name": "b",
      "labels": {
        "team": "server"
      }
    }
  ],
  "pods": [
    {
      "name": "client",
      "namespace": "a",
      "labels": {
        "app": "client"
      },
      "ip": "10.0.0.1",
      "ports": []
    },
    {
      "name": "server",
      "namespace": "b",
      "labels": {
        "app": "server"
      },
      "ip": "10.0.0.2",
      "ports": [
        {
          "name": "https",
          "port": 443,
          "protocol": "TCP"
        }
      ]
    }
  ],
  "policies": [
    {
      "apiVersion": "networking.k8s.io/v1",
      "kind": "NetworkPolicy",
      "metadata": {
        "name": "server-ingress",
        "namespace": "b"
      },
      "spec": {
        "podSelector": {
          "matchLabels": {
            "app": "server"
          }
        },
        "policyTypes": [
          "Ingress"
        ],
        "ingress": [
          {
            "from": [
              {
                "namespaceSelector": {
                  "matchLabels": {
                    "team": "client"
                  }
                },
                "podSelector": {
                  "matchLabels": {
                    "app": "client"
                  }
                }
              }
            ],
            "ports": [
              {
                "port": "https",
                "protocol": "TCP"
              }
            ]
          }
        ]
      }
    }
  ],
  "queries": [
    {
      "source": {
        "namespace": "a",
        "pod": "client"
      },
      "destination": {
        "namespace": "b",
        "pod": "server"
      },
      "protocol": "TCP",
      "port": 443
    },
    {
      "source": {
        "namespace": "a",
        "pod": "client"
      },
      "destination": {
        "namespace": "b",
        "pod": "server"
      },
      "protocol": "TCP",
      "port": 80
    }
  ]
}
